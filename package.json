{
  "name": "overflow-scout",
  "version": "0.1.0",
  "description": "Stress-test text overflow on live web applications",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "tsc && vite build",
    "build:zip": "npm run build && cd dist && zip -r ../overflow-scout.zip . && cd ..",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.10"
  },
  "keywords": [
    "chrome-extension",
    "overflow",
    "testing",
    "ui",
    "qa"
  ],
  "author": "",
  "license": "MIT"
}
